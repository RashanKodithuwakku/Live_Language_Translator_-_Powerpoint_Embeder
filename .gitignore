# ─── Google Cloud credentials (NEVER commit these, NEVER push) ────────────
# Blanket *.json also covers the service-account key. phrase/blocklist JSON
# that belongs in git must be force-added; the key file must not.
.env
*.json
!package.json
!package-lock.json
!tsconfig*.json
keys/
backend/keys/
backend/*service*account*.json
backend/live-translator-*.json
**/credentials*.json
**/*-credentials.json
**/*service-account*.json
.env.*
!.env.example
backend/.env.*
!backend/.env.example

