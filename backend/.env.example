# ─────────────────────────────────────────────────────────────
# Live Translator – Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file to ".env" in the same directory.
# 2. Fill in the values below (never commit ".env" to Git).
# ─────────────────────────────────────────────────────────────

# Absolute (or relative-to-backend/) path to your Google Cloud
# service account JSON key file.
# Example (Windows):  C:\keys\live-translator-sa.json
# Example (relative): ../keys/live-translator-sa.json
GOOGLE_APPLICATION_CREDENTIALS=./keys/service_account.json

# Google Cloud project ID (used for Translation API calls)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# FastAPI server settings
HOST=127.0.0.1
PORT=8000

# Noise reduction strength (0.0 = off, 1.0 = aggressive)
# Start around 0.5 and tune at the venue.
NOISE_REDUCTION_STRENGTH=0.5

# Google STT streaming session hard limit is 305 s.
# We restart the stream at this interval (seconds) to stay safe.
STT_SESSION_RESTART_INTERVAL=240
