# ─────────────────────────────────────────────────────────────
# Live Translator – Backend Environment Variables
# Copy to ".env" and fill in. Never commit ".env" or the JSON key.
# ─────────────────────────────────────────────────────────────

GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# eco = daily testing (lowest spend). event = rehearsal + presentation days.
PROFILE=eco
# live = real Google APIs. cache = fixtures only (zero API spend; UI only).
MODE=live

# ── Speech-to-Text ──────────────────────────────────────────
# si-LK / ta-* only support "default" / "command_and_search" in v1.
STT_MODEL=default
STT_PRIMARY_LANGUAGE=si-LK
STT_ALTERNATIVE_LANGUAGES=ta-LK,en-US
PARALLEL_LANGUAGES=si-LK,ta-IN,en-US
# 0 = single scout + alternatives (ECO). 1 = parallel + arbiter (EVENT).
# 2 = word-level fusion (experimental; needs ENABLE_STRATEGY_2=true).
ARBITER_STRATEGY=0
ENABLE_STRATEGY_2=false
STT_AUTO_PUNCTUATION=true
STT_WORD_CONFIDENCE=true
STT_WORD_TIME_OFFSETS=true
STT_SESSION_RESTART_INTERVAL=240
STT_ENDPOINT_SILENCE_MS=700
STT_MAX_UTTERANCE_S=15

# Spectral denoise OFF by default. High-pass always on.
NOISE_REDUCTION_STRENGTH=0
ENABLE_NORMALIZE=true

# ── VAD / session gating (saves billed audio seconds) ───────
VAD_ENABLED=true
VAD_AGGRESSIVENESS=2
VAD_PREROLL_MS=500
VAD_HANGOVER_MS=900
VAD_MIN_SPEECH_MS=250
IDLE_CLOSE_SECONDS=12
IDLE_PAUSE_SECONDS=180
NOISE_BURN_SECONDS=60

# ── Translation ─────────────────────────────────────────────
TRANSLATE_CACHE=true
TRANSLATE_TIMEOUT_S=4
# Progressive interim translation is EVENT-only by default.
TRANSLATE_PROGRESSIVE=false
TRANSLATE_MIN_INTERVAL_MS=350

# ── Content filter (captions) ───────────────────────────────
# Google's own profanity masking (mainly English).
STT_PROFANITY_FILTER=true
# Blocklist filter on original, Sinhala and Tamil lines (blocklist.json).
FILTER_ENABLED=true
# drop = hide the whole caption (event days). mask = show "…" (testing).
FILTER_ACTION=drop

# ── Budget guard ────────────────────────────────────────────
DAILY_BUDGET_USD=10
TOTAL_BUDGET_USD=250

MAX_PRESENTATION_MB=1024
PRESENTATION_CONVERSION_TIMEOUT=300
