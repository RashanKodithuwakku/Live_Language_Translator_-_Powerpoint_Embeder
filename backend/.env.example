# ─────────────────────────────────────────────────────────────
# Live Translator – Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file to ".env" in the same directory.
# 2. Fill in the values below (never commit ".env" to Git).
# ─────────────────────────────────────────────────────────────

# Path to your Google Cloud service account JSON key file.
# Relative paths are resolved from the backend/ folder.
# Example (Windows absolute): C:\keys\live-translator-sa.json
# Put your downloaded Google service-account JSON in backend/ and point here.
# Never commit that JSON file. Example name only — use YOUR file's real name locally.
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json

# Google Cloud project ID (informational; shown on /health)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# FastAPI server settings (used by `python main.py`)
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ── Speech-to-Text ──────────────────────────────────────────
# si-LK and ta-LK are only supported by the "default" and
# "command_and_search" models in the v1 API — keep "default".
STT_MODEL=default
STT_PRIMARY_LANGUAGE=si-LK
STT_ALTERNATIVE_LANGUAGES=ta-LK,en-US
STT_AUTO_PUNCTUATION=true

# Google closes a stream after ~305 s. The backend opens a new stream at
# the first pause after this many seconds (hard limit +40 s, max 290 s).
STT_SESSION_RESTART_INTERVAL=240

# End of sentence: after the speaker pauses this long, the sentence is
# finalized and captioned (Google's own si-LK endpointing takes 14-29 s).
# Raise to ~1000 for slow speakers whose sentences get split mid-way.
STT_ENDPOINT_SILENCE_MS=700
# A speaker who never pauses is captioned at the next breath after this.
STT_MAX_UTTERANCE_S=15

# ── Signal cleanup ──────────────────────────────────────────
# Spectral-gate strength (0.0 = off, 1.0 = aggressive). An 80 Hz high-pass
# filter is always applied. Google recommends light processing, so tune at
# the venue: 0.3–0.5 for HVAC/projector hum, 0 if speech sounds watery.
NOISE_REDUCTION_STRENGTH=0.5

# ── Presentations (.pptx conversion) ────────────────────────
# Where converted decks and extracted videos are cached.
# PRESENTATIONS_DIR=./.presentations
# Only needed if LibreOffice is installed somewhere non-standard.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
MAX_PRESENTATION_MB=1024
PRESENTATION_CONVERSION_TIMEOUT=300
